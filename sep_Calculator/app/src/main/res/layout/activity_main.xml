<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#080808" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="sep Calculator" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/><Button android:id="@+id/themeButton" android:layout_width="48dp" android:layout_height="44dp" android:text="☀" android:textSize="18sp" android:background="@drawable/button_bg"/></LinearLayout>
<TextView android:id="@+id/history" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical|end" android:textColor="#A8A8A8" android:textSize="14sp" android:maxLines="1" android:ellipsize="start"/>
<TextView android:id="@+id/display" android:layout_width="match_parent" android:layout_height="105dp" android:gravity="center_vertical|end" android:text="0" android:textColor="#FFFFFF" android:textSize="42sp" android:padding="8dp" android:maxLines="2" android:ellipsize="start"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="52dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"><Button android:id="@+id/sin" android:text="sin" style="@style/CalcButton"/><Button android:id="@+id/cos" android:text="cos" style="@style/CalcButton"/><Button android:id="@+id/tan" android:text="tan" style="@style/CalcButton"/><Button android:id="@+id/sqrt" android:text="√" style="@style/CalcButton"/><Button android:id="@+id/pow" android:text="x²" style="@style/CalcButton"/><Button android:id="@+id/historyButton" android:text="History" style="@style/CalcButton"/></LinearLayout></HorizontalScrollView>
<GridLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:columnCount="4" android:rowCount="5" android:useDefaultMargins="true">
<Button android:id="@+id/clear" android:text="C" style="@style/CalcButton"/><Button android:id="@+id/back" android:text="⌫" style="@style/CalcButton"/><Button android:id="@+id/paren" android:text="( )" style="@style/CalcButton"/><Button android:id="@+id/div" android:text="÷" style="@style/OpButton"/>
<Button android:id="@+id/n7" android:text="7" style="@style/CalcButton"/><Button android:id="@+id/n8" android:text="8" style="@style/CalcButton"/><Button android:id="@+id/n9" android:text="9" style="@style/CalcButton"/><Button android:id="@+id/mul" android:text="×" style="@style/OpButton"/>
<Button android:id="@+id/n4" android:text="4" style="@style/CalcButton"/><Button android:id="@+id/n5" android:text="5" style="@style/CalcButton"/><Button android:id="@+id/n6" android:text="6" style="@style/CalcButton"/><Button android:id="@+id/minus" android:text="−" style="@style/OpButton"/>
<Button android:id="@+id/n1" android:text="1" style="@style/CalcButton"/><Button android:id="@+id/n2" android:text="2" style="@style/CalcButton"/><Button android:id="@+id/n3" android:text="3" style="@style/CalcButton"/><Button android:id="@+id/plus" android:text="+" style="@style/OpButton"/>
<Button android:id="@+id/percent" android:text="%" style="@style/CalcButton"/><Button android:id="@+id/n0" android:text="0" style="@style/CalcButton"/><Button android:id="@+id/dot" android:text="." style="@style/CalcButton"/><Button android:id="@+id/equal" android:text="=" style="@style/EqualButton"/></GridLayout>
<Button android:id="@+id/copy" android:layout_width="match_parent" android:layout_height="48dp" android:text="Copy result" android:textColor="#FFFFFF" android:background="@drawable/button_bg"/></LinearLayout>
